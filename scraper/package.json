{
  "name": "poolpulse-scraper",
  "version": "1.0.0",
  "description": "Timetable scraper for PoolPulse — extracts lane swimming sessions from Edinburgh Leisure",
  "main": "scraper.js",
  "scripts": {
    "scrape": "node scraper.js",
