    "scrape:commonwealth:dry": "node scraper.js royal-commonwealth --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "puppeteer": "^22.15.0"
  }
}
